{
  "overrides": [
    {
      "files": ["./app/**/*.{js,ts,jsx,tsx}"]
    }
  ],
  "arrowParens": "always",
  "bracketSameLine": false,
  "insertPragma": false,
  "jsxSingleQuote": false,
  "tabWidth": 2,
  "useTabs": false,
  "semi": true,
  "singleAttributePerLine": true,
  "singleQuote": true,
  "trailingComma": "none"
}
